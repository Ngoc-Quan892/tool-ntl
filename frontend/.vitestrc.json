{
  "coverage": {
    "provider": "v8",
    "reporter": ["text", "json", "html"],
    "exclude": [
      "node_modules/**",
      "src/test/**",
      "**/*.d.ts",
      "**/*.config.*",
      "**/mockData/**",
      "e2e/**"
    ],
    "thresholds": {
      "lines": 80,
      "functions": 80,
      "branches": 80,
      "statements": 80
    }
  }
}

