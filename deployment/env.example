# ==================== PRODUCTION ENVIRONMENT CONFIGURATION ====================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production file to version control

# ==================== DATABASE (PostgreSQL) ====================
POSTGRES_DB=baccarat
POSTGRES_USER=baccarat_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_PORT=5432

# ==================== REDIS CACHE ====================
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# ==================== APPLICATION ====================
APP_NAME=Baccarat Predictor Pro
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==================== SECURITY ====================
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== CORS ====================
# JSON array format for docker-compose
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ==================== DATABASE CONNECTION POOL ====================
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== PERFORMANCE ====================
WORKERS=4
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ==================== ML & SIMULATION ====================
ML_MODEL_PATH=/app/ml-models
MAX_SIMULATION_SHOES=10000
SIMULATION_BATCH_SIZE=100

# ==================== WEBSOCKET ====================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# ==================== FRONTEND ====================
VITE_API_URL=https://yourdomain.com/api

# ==================== PORTS ====================
HTTP_PORT=80
HTTPS_PORT=443

